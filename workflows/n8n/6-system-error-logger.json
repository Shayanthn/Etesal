{
  "name": "Etesal 6. System Error Logger (Global Alert)",
  "nodes": [
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const errData = $input.all()[0]?.json || {};\n\n// Construct a beautiful and resilient HTML alert message\nconst workflowName = errData.workflow?.name || 'Unknown Workflow';\nconst nodeName = errData.execution?.error?.node?.name || 'Unknown Node';\nconst rawErrorMsg = errData.execution?.error?.message || 'Unknown Error';\n\n// Safely escape HTML characters\nconst escapeHtml = (str) => String(str)\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst alertMsg = `🚨 <b>آلارم بحرانی سیستم (n8n)</b> 🚨\\n\\n` +\n`📦 <b>ورک‌فلو:</b> ${escapeHtml(workflowName)}\\n` +\n`🛑 <b>نود خطا دهنده:</b> ${escapeHtml(nodeName)}\\n\\n` +\n`⚠️ <b>متن خطا:</b>\\n<code>${escapeHtml(rawErrorMsg)}</code>\\n\\n` +\n`⏱️ <b>زمان:</b> ${new Date().toLocaleString('fa-IR')}`;\n\nreturn [{ json: { text: alertMsg } }];"
      },
      "id": "format-error",
      "name": "Format Error Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $vars.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $vars.TELEGRAM_ADMIN_ID }}\",\n  \"text\": {{ JSON.stringify($json.text || \"\") }},\n  \"parse_mode\": \"HTML\"\n}",
        "options": {
          "timeout": 15000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        }
      },
      "id": "telegram-send",
      "name": "Send Alert to Admin Channel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        300
      ]
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Format Error Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Error Message": {
      "main": [
        [
          {
            "node": "Send Alert to Admin Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "51545002252b44501c9ca0ee502e016b2ddf3c04a2e95f2478721b19136e749e"
  }
}