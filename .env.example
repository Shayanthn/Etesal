# 1. Supabase Live Backend Integration (Optional for local, required for live DB)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2. Admin Security Passcode Hash (SHA-256)
# Default hash corresponds to secure master passphrase: EtesalAdmin2026!
VITE_ADMIN_PASSWORD_HASH=7708b01e38666e98cd78c95074bba64892ec31c3f5a06d5d23108fd451fad754

# 3. Cloudflare Worker Gateway (For edge ping & Telegram webhooks)
# Set to custom route (e.g. https://etesal.aetherai.ir/api) or workers.dev endpoint
VITE_CF_WORKER_API=https://etesal.aetherai.ir/api
